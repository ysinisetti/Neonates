{
  "info": {
    "name": "Neonates Hospital API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "hospital_id",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Create Hospital",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"hospitalName\": \"City General Hospital\",\n  \"hospitalType\": \"BRC\",\n  \"city\": \"New York\",\n  \"state\": \"NY\",\n  \"spocName\": \"Dr. John Smith\",\n  \"spocPhone\": \"+1234567890\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/hospitals",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "hospitals"
          ]
        }
      }
    },
    {
      "name": "Get Hospital by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/hospitals/{{hospital_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "hospitals",
            "{{hospital_id}}"
          ]
        }
      }
    },
    {
      "name": "Get All Hospitals",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/hospitals",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "hospitals"
          ]
        }
      }
    },
    {
      "name": "Update Hospital",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"hospitalName\": \"Updated City General Hospital\",\n  \"hospitalType\": \"BRRC\",\n  \"city\": \"New York\",\n  \"state\": \"NY\",\n  \"spocName\": \"Dr. Jane Doe\",\n  \"spocPhone\": \"+0987654321\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/hospitals/{{hospital_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "hospitals",
            "{{hospital_id}}"
          ]
        }
      }
    },
    {
      "name": "Deactivate Hospital",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/hospitals/{{hospital_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "hospitals",
            "{{hospital_id}}"
          ]
        }
      }
    }
  ]
}
